# =========================================================
#  依赖
# =========================================================
node_modules/
.pnpm-store/

# =========================================================
#  构建与打包产物
# =========================================================
# dist/ 会匹配任意层级：web/dist（前端产物）、server/dist（tsc 输出）、根 dist/（打包结果）
dist/
# 重打包前把旧产物挪走用的中转目录（dist.old / dist.prev / dist.fail 等）。
# 沙箱下原地删除大目录会失败，只能改名挪开，它们同样不该入库。
dist.*/
**/dist.*/
build/
release/
# 离线包压缩后 100MB 上下，GitHub 单文件上限就是 100MB，绝不该入库
*.zip

# =========================================================
#  运行时数据（这些全是本机跑出来的，仓库里一份都不该有）
# =========================================================
storage/
server/storage/
logs/
server/logs/
# 磁盘发布的默认路径范围（运行目录下的 Download）。开发时落在 server/Download，
# 打包后落在 dist/Download（dist 本身已被忽略）。里面放的是待发布的原始文件，不入库。
Download/
server/Download/
.pm2/
ecosystem.config.json

# =========================================================
#  数据库
# =========================================================
# 表结构由 server/prisma/schema.prisma 定义，dev.db 是本地 db:push 生成的，
# 里面还有真实账号，不能进仓库
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# =========================================================
#  配置与密钥
# =========================================================
.env
.env.*
# 示例配置要留在仓库里（顺序不能反，后写的规则才生效）
!.env.example
!.env.*.example
# 没配置 JWT_SECRET 时自动生成并落盘的签名密钥（权限 0600）。
# 它等价于 .env 里的密钥，泄露即可伪造任意账号（含管理员）的登录态。
.jwt-secret
# 没配置 ACCESS_CODE_KEY 时自动生成并落盘的提取码加密密钥（权限 0600）。
# 泄露它 = 库内所有提取码可解；弄丢它 = 所有提取码解不开（分享还在，需重设）。
.access-code-key

# =========================================================
#  日志
# =========================================================
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
pack.log

# =========================================================
#  编辑器 / IDE / 系统
# =========================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# =========================================================
#  工具缓存
# =========================================================
*.tsbuildinfo
.vite/
.eslintcache
.cache/

# =========================================================
#  本机遗留
# =========================================================
# Windows 保留设备名文件，删不掉，但更不该提交
NUL
# 本机待办与安全审计记录，只在本机维护，不入库
TODO.md
