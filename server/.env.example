# 复制为 .env 后按需修改

# 服务端口
PORT=3000
HOST=0.0.0.0

# JWT 签名密钥。**这里保持占位值**是故意的：占位值等同于「没配」，
# 应用启动时会自动读取（没有则生成）<运行目录>/.jwt-secret 并落盘，
# 所以复制本文件后不填也能安全运行，不会退回到一个人人皆知的固定密钥。
# 想显式固定下来，就换成自己生成的随机串：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 改这个值会让所有已登录的会话立即失效。
JWT_SECRET=please-change-this-secret

# SQLite 数据库文件位置（相对 server 目录）
DATABASE_URL="file:./dev.db"

# 上传文件的存储根目录（相对 server 目录，也可以填绝对路径如 D:\\ShareEverythingData）
STORAGE_ROOT=./storage

# 单个上传文件大小上限（字节，默认 2GB）
MAX_UPLOAD_SIZE=2147483648

# JSON / urlencoded 请求体的全局上限（字节，默认 1MB）。
# 只约束非上传接口 —— Fastify 会把这类请求体整个缓冲进内存，放太大会变成内存敞口。
# 文件上传走 multipart，不受这一项影响。
BODY_LIMIT=1048576

# 允许跨域访问的来源白名单，逗号（或分号）分隔。不配置 = 不注册 CORS，只接受同源请求。
# 本应用前后端同源（开发靠 Vite 代理，生产共用一个端口），通常不需要打开。
# 只有把前端部署到别的域名时才填写，例如：CORS_ORIGINS=https://a.example,https://b.example
# 写 * 表示放开任意来源，此时浏览器不允许携带凭证，登录态会失效，仅建议临时排障用。
# CORS_ORIGINS=

# 限流（每个 IP）
# 全局限流：每分钟请求数上限。注意分片上传与可续传下载这两类接口不受它约束。
RATE_LIMIT_MAX=1200
# 登录 / 注册：窗口内允许的尝试次数。这是唯一靠猜就能拿到权限的入口，压最严。
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=5
# 整目录打包（最吃 CPU 的公开接口）：每分钟上限
RATE_LIMIT_ARCHIVE_MAX=120

# 提取码防爆破：同一个 IP 对同一个分享连续猜错多少次后暂时拒绝。
# 只统计失败次数，校验成功即清零 —— 正常浏览不会被自己的操作连累。
ACCESS_CODE_MAX_FAILS=8
ACCESS_CODE_WINDOW_SECONDS=600

# 提取码的**加密密钥**。库里的提取码是加密后存的（要在界面上反复回显，
# 所以不能只存哈希），加密用 AES-256-GCM，每条记录一个随机盐。
# 这一项就是那把钥匙：
#   · 这里留占位值 = 没配，启动时会读取（没有则生成）<运行目录>/.access-code-key
#   · 想显式固定下来（推荐，便于与数据库分开备份），换成自己生成的随机串：
#       node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   · 也可以填一句口令（至少 8 个字符），启动时会先过一遍 scrypt 再当密钥用
# ⚠️ 换掉这个值会让库里所有提取码解不开（分享本身还在，重设提取码即可）。
# ⚠️ 它泄露 = 库内所有提取码可解；因此不要和 dev.db 放在一起备份，也不要提交到仓库。
ACCESS_CODE_KEY=please-change-this-access-code-key

# 管理员密码找回（默认关闭）
# 打开后，用管理员账号在登录页登录时若密码不对，本次填写的密码会被设为该账号的新密码，
# 然后直接登录 —— 给「管理员忘记密码」留一条后路。用完请立刻改回 false。
ALLOW_ADMIN_RESET_PASSWORD=false

# 谁能发布磁盘目录：ADMIN = 仅管理员（默认），USER = 任何登录用户
# 磁盘发布是全站共享的，发布一个目录等于广播给所有登录用户。
# 确认所有能登录的人互信时，改成 USER 即可让所有人发布。
MOUNT_CREATE_ROLE=ADMIN

# 允许发布 / 允许在选择器里浏览的路径范围，分号（或竖线）分隔。
# 不配置 = 默认收窄到 <运行目录>/Download（打包后的安装目录下的 Download 目录，会自动创建）。
# 这一项同时管两件事：① 能发布哪些路径；② 「选择路径」弹窗能浏览到哪儿。
# 想恢复成「不限制」（能登录即可发布任意目录），显式写：MOUNT_ALLOWED_ROOTS=*
# MOUNT_ALLOWED_ROOTS=D:\share;D:\movie

# 目录打包下载（ZIP）的限额
ZIP_MAX_FILES=50000
ZIP_MAX_TOTAL_BYTES=21474836480
ZIP_MAX_DEPTH=32
# 同时最多几个打包请求，超出的排队
ZIP_CONCURRENCY=2
# 默认压缩档位：store = 不压缩 / smart = 智能（默认）/ deflate = 全部压缩
ZIP_DEFAULT_MODE=smart
# 单文件超过这个体积就不压缩（压缩要在内存里攒结果，防止被超大文件撑爆）
ZIP_DEFLATE_MAX_FILE_BYTES=268435456
# 预检结果缓存秒数
ZIP_PLAN_CACHE_TTL=60
# 同一个分享两次打包之间的最小间隔（秒）
ZIP_THROTTLE_SECONDS=60

# 后台打包任务（大目录先在服务端生成 zip，再以普通文件方式下载，支持断点续传）
# 打包结果保留小时数
ARCHIVE_JOB_TTL_HOURS=6
# 超过这两个阈值就走后台打包而不是同步流式
ARCHIVE_ASYNC_THRESHOLD_BYTES=2147483648
ARCHIVE_ASYNC_THRESHOLD_FILES=2000
# 同时存在的打包任务数上限（含排队与进行中）
ARCHIVE_MAX_JOBS=8
# 过期任务扫描间隔（分钟）
ARCHIVE_CLEANUP_INTERVAL_MINUTES=30
